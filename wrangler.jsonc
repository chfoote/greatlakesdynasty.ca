{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "greatlakesdynasty-ca",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "keep_vars": true,
  "vars": {
    "RANKING_SNAPSHOTS_SUPABASE_URL": "https://ptexqhshfyjfnmlwyzzv.supabase.co"
  },
  "triggers": {
    "crons": ["30 11 * * *", "5,35 * * * *", "10,25,40,55 * * * *", "1,11,21,31,41,51 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/nhl-api", "/nhl-api/*",
      "/nhl-web-api", "/nhl-web-api/*",
      "/nhl-search-api", "/nhl-search-api/*"
    ]
  }
}
