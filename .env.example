# Supabase credentials — get these from your Supabase project:
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Enable after the Worker has saved and verified a real ranking snapshot.
VITE_RANKING_SNAPSHOTS=false

# Standings and stat pages reuse saved full-season NHL inputs plus today’s games.
VITE_SEASON_SNAPSHOTS=false

# Farm rankings reuse the shared result/draft history and verify live inputs.
VITE_FARM_SNAPSHOTS=false

# Reuse completed NHL ownership spans in the Record Book
VITE_RECORD_BOOK_SNAPSHOTS=false
