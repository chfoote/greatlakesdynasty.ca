{
  "rewrites": [
    {
      "source": "/nhl-api/:path*",
      "destination": "https://api.nhle.com/stats/rest/en/:path*"
    },
    {
      "source": "/nhl-web-api/:path*",
      "destination": "https://api-web.nhle.com/v1/:path*"
    },
    {
      "source": "/nhl-search-api/:path*",
      "destination": "https://search.d3.nhle.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
